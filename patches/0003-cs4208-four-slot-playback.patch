@@ -742,6 +742,15 @@
 			   cs4208_fixups);
 	snd_hda_apply_fixup(codec, HDA_FIXUP_ACT_PRE_PROBE);
 
+	/* A1534's active-low amplifier supply FETs are GPIO4/5. Preserve
+	 * the reviewed setup_a1534() GPIO regime through cs_init()/resume,
+	 * rather than letting the fallback GPIO0 fixup disable those pins. */
+	if (codec->core.subsystem_id == 0x106b6500) {
+		spec->gpio_mask = 0x37;
+		spec->gpio_dir = 0x31;
+		spec->gpio_data = 0x01;
+	}
+
 	snd_hda_override_wcaps(codec, 0x18,
 			       get_wcaps(codec, 0x18) | AC_WCAP_STEREO);
 	cs4208_fix_amp_caps(codec, 0x18);
--- a/patch_cirrus/patch_cirrus_a1534_pcm.h
